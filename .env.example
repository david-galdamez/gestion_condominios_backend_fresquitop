# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL (consumido por docker-compose para inicializar el contenedor)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=si_be_boilerplate
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Prisma
# Al correr la API en el host contra el Postgres de Docker, el host es localhost.
# Al correr la API dentro de docker-compose, docker-compose.yml sobreescribe
# esta variable para apuntar al servicio `postgres` en lugar de `localhost`.
# ---------------------------------------------------------------------------
# En producción (Neon): cadena DIRECTA (host sin "-pooler"), con sslmode=require y
# sin channel_binding. Ver docs/06-despliegue.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/si_be_boilerplate?schema=public

# ---------------------------------------------------------------------------
# Autenticación
# Generá un secreto propio: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# CORS
# Orígenes del frontend permitidos, separados por comas y sin barra final.
# Si no se define, en desarrollo se permite http://localhost:3001.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Contraseñas del seed (npm run db:seed). SOLO para desarrollo local.
# Con NODE_ENV=production el seed exige las tres y falla si falta alguna.
# ---------------------------------------------------------------------------
SEED_PASSWORD_ADMIN=admin-local-1234
SEED_PASSWORD_RESIDENTE=residente-local-1234
SEED_PASSWORD_SEGURIDAD=seguridad-local-1234
