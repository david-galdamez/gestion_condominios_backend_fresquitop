// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// Rol GLOBAL por usuario (un solo condominio en el sistema).
enum Rol {
  RESIDENTE
  ADMINISTRADOR
  SEGURIDAD

  @@map("rol")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  nombre       String
  rol          Rol      @default(RESIDENTE)
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens        RefreshToken[]
  unidades             UsuarioUnidad[]
  autorizacionesVisita AutorizacionVisita[]
  reportes             Reporte[]
  historialReportes    HistorialReporte[]
  paquetesRecibidos    Paquete[]

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Torre {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unidades Unidad[]

  @@map("torre")
}

model Unidad {
  id      String @id @default(uuid()) @db.Uuid
  torreId String @map("torre_id") @db.Uuid
  torre   Torre  @relation(fields: [torreId], references: [id], onDelete: Restrict)

  // Identificador legible, ej. "A-101".
  codigo    String   @unique
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios       UsuarioUnidad[]
  cuotas         Cuota[]
  autorizaciones AutorizacionVisita[]
  paquetes       Paquete[]

  @@index([torreId])
  @@map("unidad")
}

// Relación N:M entre usuarios y unidades (un residente puede tener varias).
model UsuarioUnidad {
  usuarioId String @map("usuario_id") @db.Uuid
  usuario   User   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  unidadId String @map("unidad_id") @db.Uuid
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([usuarioId, unidadId])
  @@index([unidadId])
  @@map("usuario_unidad")
}

enum EstadoCuota {
  PENDIENTE
  VENCIDA
  PAGADA

  @@map("estado_cuota")
}

// Cuota mensual de mantenimiento de una unidad. No se borra: el historial es
// parte del estado de cuenta (por eso onDelete Restrict y sin endpoint delete).
model Cuota {
  id       String @id @default(uuid()) @db.Uuid
  unidadId String @map("unidad_id") @db.Uuid
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  // "YYYY-MM"; ordena bien como texto.
  periodo          String      @db.Char(7)
  // CHECK (monto > 0) agregado a mano en el SQL de la migración.
  monto            Decimal     @db.Decimal(10, 2)
  fechaVencimiento DateTime    @map("fecha_vencimiento") @db.Date
  estado           EstadoCuota @default(PENDIENTE)
  pagadaEn         DateTime?   @map("pagada_en")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@unique([unidadId, periodo])
  @@index([unidadId, estado])
  @@map("cuota")
}

enum TipoDocumento {
  DUI
  PASAPORTE

  @@map("tipo_documento")
}

enum EstadoAutorizacion {
  VIGENTE
  USADA
  CANCELADA
  VENCIDA

  @@map("estado_autorizacion")
}

// Pre-autorización de un visitante creada por un residente. No se borra: el
// historial sirve a seguridad y auditoría (cancelar solo cambia el estado).
model AutorizacionVisita {
  id String @id @default(uuid()) @db.Uuid

  unidadId String @map("unidad_id") @db.Uuid
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  // Siempre sale de la sesión, nunca del cliente.
  residenteId String @map("residente_id") @db.Uuid
  residente   User   @relation(fields: [residenteId], references: [id], onDelete: Restrict)

  nombre          String        @db.VarChar(60)
  tipoDocumento   TipoDocumento @map("tipo_documento")
  numeroDocumento String        @map("numero_documento") @db.VarChar(12)
  placa           String?       @db.VarChar(10)

  // Fecha y hora locales del negocio, sin zona: por eso date y time.
  fechaVisita  DateTime @map("fecha_visita") @db.Date
  horaEstimada DateTime @map("hora_estimada") @db.Time(0)

  // 6 dígitos; único solo dentro del día de la visita (se reutiliza entre días).
  codigo String             @db.Char(6)
  estado EstadoAutorizacion @default(VIGENTE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([codigo, fechaVisita])
  @@index([residenteId, fechaVisita])
  @@map("autorizacion_visita")
}

enum Mensajeria {
  CORREOS
  DHL
  FEDEX
  UPS
  AMAZON
  OTRA

  @@map("mensajeria")
}

// H09 solo crea EN_PORTERIA; RETENIDO lo marca el sistema y ENTREGADO lo hace H10.
enum EstadoPaquete {
  EN_PORTERIA
  RETENIDO
  ENTREGADO

  @@map("estado_paquete")
}

// Paquete recibido en portería (H09). No se borra: es la constancia de recepción.
model Paquete {
  id String @id @default(uuid()) @db.Uuid

  // "PAQ-000123": sale de la secuencia paquete_codigo_seq (creada en el SQL de la migración).
  codigoPaquete String @unique @map("codigo_paquete") @db.VarChar(10)
  // 6 dígitos aleatorios. Solo lo ve el residente; nunca se devuelve a seguridad.
  codigoRetiro  String @map("codigo_retiro") @db.Char(6)

  unidadId String @map("unidad_id") @db.Uuid
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  // Nombre que trae la etiqueta (no tiene que ser un usuario).
  destinatario String     @db.VarChar(60)
  mensajeria   Mensajeria
  guia         String?    @db.VarChar(40)
  // Ruta relativa dentro de UPLOAD_DIR, p. ej. "paquetes/<uuid>.jpg".
  fotoUrl      String     @map("foto_url") @db.VarChar(255)

  estado     EstadoPaquete @default(EN_PORTERIA)
  recibidoEn DateTime      @default(now()) @map("recibido_en")

  // Guardia que lo recibió: siempre sale de la sesión.
  recibidoPorId String @map("recibido_por") @db.Uuid
  recibidoPor   User   @relation(fields: [recibidoPorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([estado, recibidoEn])
  @@index([unidadId, estado])
  @@map("paquete")
}

// Área común reservable (H03). No se borra: desactivarla conserva el historial
// y las reservas futuras confirmadas (H04).
model AreaComun {
  id     String @id @default(uuid()) @db.Uuid
  // Único; además el servicio compara sin distinguir mayúsculas.
  nombre String @unique @db.VarChar(40)

  // CHECK (capacidad BETWEEN 1 AND 200) agregado a mano en el SQL de la migración.
  capacidad Int

  // Hora local del negocio, sin zona. CHECK (en punto y cierre > apertura) en el SQL.
  horaApertura DateTime @map("hora_apertura") @db.Time(0)
  horaCierre   DateTime @map("hora_cierre") @db.Time(0)

  // CHECK (duracion_max_horas BETWEEN 1 AND 8) en el SQL.
  duracionMaxHoras Int     @default(3) @map("duracion_max_horas")
  activa           Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("area_comun")
}

// ---------------------------------------------------------------------------
// H05 · Reportes de incidencias y mantenimiento
// ---------------------------------------------------------------------------

enum CategoriaReporte {
  FUGA
  LUMINARIA
  ASCENSOR
  LIMPIEZA
  OTRO

  @@map("categoria_reporte")
}

enum PrioridadReporte {
  BAJA
  MEDIA
  ALTA

  @@map("prioridad_reporte")
}

enum EstadoReporte {
  ABIERTO
  EN_PROCESO
  RESUELTO

  @@map("estado_reporte")
}

// Problema reportado por un residente. Se muestra como REP-000123.
model Reporte {
  id String @id @default(uuid()) @db.Uuid

  // Consecutivo (serial de Postgres); la API lo formatea como "REP-000123".
  numero Int @unique @default(autoincrement())

  residenteId String @map("residente_id") @db.Uuid
  residente   User   @relation(fields: [residenteId], references: [id], onDelete: Restrict)

  titulo      String           @db.VarChar(80)
  categoria   CategoriaReporte
  // Una torre (tabla `torre`) o un área común de la lista fija del backend.
  ubicacion   String
  descripcion String           @db.VarChar(500)

  // Sin criterio de aceptación en H05: queda con valor por defecto.
  prioridad PrioridadReporte @default(MEDIA)
  estado    EstadoReporte    @default(ABIERTO)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  evidencias EvidenciaReporte[]
  historial  HistorialReporte[]

  @@index([residenteId, createdAt])
  @@map("reporte")
}

// Foto adjunta a un reporte. `archivo` es la llave de almacenamiento (nombre
// del archivo en disco), no una URL: la API arma la URL de descarga.
model EvidenciaReporte {
  id String @id @default(uuid()) @db.Uuid

  reporteId String  @map("reporte_id") @db.Uuid
  reporte   Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  archivo     String
  mimeType    String   @map("mime_type")
  tamanoBytes Int      @map("tamano_bytes")
  orden       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([reporteId])
  @@map("evidencia_reporte")
}

// Trazabilidad: una fila por cada estado por el que pasa el reporte.
model HistorialReporte {
  id String @id @default(uuid()) @db.Uuid

  reporteId String  @map("reporte_id") @db.Uuid
  reporte   Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  estado EstadoReporte

  cambiadoPorId String @map("cambiado_por_id") @db.Uuid
  cambiadoPor   User   @relation(fields: [cambiadoPorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([reporteId, createdAt])
  @@map("historial_reporte")
}